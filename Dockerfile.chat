FROM node:22-bookworm-slim AS node

FROM python:3.10-slim

ARG CODEX_VERSION=0.146.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CODEX_HOME=/home/chatuser/.codex

WORKDIR /app

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gosu \
    && npm install -g "@openai/codex@${CODEX_VERSION}" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY chat-entrypoint.sh /usr/local/bin/chat-entrypoint
RUN useradd --create-home --uid 10001 chatuser \
    && mkdir -p /home/chatuser/.codex \
    && chown -R chatuser:chatuser /home/chatuser /app \
    && chmod +x /usr/local/bin/chat-entrypoint

EXPOSE 8000

ENTRYPOINT ["chat-entrypoint"]
CMD ["uvicorn", "app.chat_main:app", "--host", "0.0.0.0", "--port", "8000"]
